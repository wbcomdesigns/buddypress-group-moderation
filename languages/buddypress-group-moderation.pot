#: includes/class-bp-group-moderation-admin.php:308
#, php-format
msgid ""
"<p><strong>Dear %1$s</strong></p>\n"
"\t\t\t\t\t<p>We’re happy to let you know that your group, <strong>“%2$s”</strong>, has been reviewed and approved by our moderation team!</p>\n"
"\t\t\t\t\t<p>Your group is now live and visible to the community. You can start inviting members, sharing updates, and building discussions right away.</p>\n"
"\t\t\t\t\t<p><strong>View your group : </strong></p>\n"
"\t\t\t\t\t<p><a href='%3$s'>%4$s</a></p>\n"
"\t\t\t\t\t<p>Thank you for contributing to our community. If you have any questions or need help managing your group, feel free to reach out to us.</p>\n"
"\t\t\t\t\t<p><strong>Warm Regards,</strong></p>\n"
"\t\t\t\t\t<p><strong>The %5$s Team</strong></p>"
msgstr ""

#. translators: %s: the administrator's reason for rejecting the group.
#: includes/class-bp-group-moderation-admin.php:329
#, php-format
msgid "<strong>Reason from the moderation team:</strong> %s"
msgstr ""

#. translators: %s: group name.
#: includes/class-bp-group-moderation-admin.php:333
#, php-format
msgid "Group Submission Not Approved : %s"
msgstr ""

#. translators: 1: member name, 2: group name, 3: reason paragraph (may be empty), 4: site name.
#: includes/class-bp-group-moderation-admin.php:336
#, php-format
msgid ""
"<p><strong>Dear %1$s</strong></p>\n"
"\t\t\t\t\t<p>Thank you for submitting your group, <strong>“%2$s”</strong>, to our community platform.</p>\n"
"\t\t\t\t\t<p>After a thorough review, we regret to inform you that your group submission has not been approved by our moderation team at this time.</p>\n"
"\t\t\t\t\t%3$s\n"
"\t\t\t\t\t<p>If you would like feedback on your submission or wish to explore how it could be revised to meet our community guidelines, please feel free to contact our support team.</p>\n"
"\t\t\t\t\t<p>We truly appreciate your involvement and hope you’ll continue to be an engaged member of our community.</p>\n"
"\t\t\t\t\t<p><strong>Warm regards,</strong></p>\n"
"\t\t\t\t\t<p><strong>The %4$s Team</strong></p>"
msgstr ""

