{
  "plugin": {
    "slug": "buddypress-group-moderation",
    "name": "BuddyPress Group Moderation",
    "version": "1.0.1",
    "main_file": "buddypress-group-moderation.php",
    "text_domain": "buddypress-group-moderation",
    "requires_php": "8.1",
    "scope": "single site; BuddyPress with the Groups component. Deactivates itself on BuddyBoss (bp_group_moderation_requires_buddypress).",
    "licensed": "free: EDD updater in edd-license/ (store https://wbcomdesigns.com/) on the built-in key EDD_GROUP_MODERATION_FREE_LICENSE_KEY (edd-license/edd-plugin-license.php, set at build time; bin/build-release.sh fails while empty). Registered on init so cron/WP-CLI update checks work; no key, no updater. No licence UI, no stored key or status. Store side: the download id must be in wbcom_free_license_download_ids() (store free licence passthrough)."
  },
  "rest": {
    "namespace": null,
    "endpoints": []
  },
  "ajax": [
    {
      "action": "bp_group_moderation_handle_group",
      "handler": "BP_Group_Moderation_Admin::bp_group_moderation_ajax_handle_group",
      "file": "includes/class-bp-group-moderation-admin.php",
      "nonce": "bp_group_moderation_nonce (POST nonce, localized as bpGroupModeration.nonce)",
      "capability": "manage_options",
      "params": [
        "action_type: approve|reject",
        "group_id"
      ],
      "used_by": "assets/js/bp-group-moderation-admin.js (row Approve/Reject, Approve selected)"
    }
  ],
  "admin_pages": [
    {
      "slug": "bp-pending-groups",
      "parent": "bp-groups",
      "title": "Pending Groups",
      "capability": "manage_options",
      "hook": "bp_admin_menu",
      "callback": "BP_Group_Moderation_Admin::bp_group_moderation_admin_page_content",
      "note": "20 per page (paged GET), pending count bubble on the menu item"
    },
    {
      "slug": "wbcomplugins",
      "parent": null,
      "title": "WB Plugins",
      "capability": "manage_options",
      "hook": "admin_menu",
      "callback": "BP_Group_Moderation_Settings::render_hub",
      "note": "only registered when no other Wbcom plugin created it first"
    },
    {
      "slug": "bp-group-moderation",
      "parent": "wbcomplugins",
      "title": "Group Moderation",
      "capability": "manage_options",
      "hook": "admin_menu",
      "callback": "BP_Group_Moderation_Settings::render_page"
    }
  ],
  "admin_tabs": [
    {
      "slug": "general",
      "view": "includes/admin/views/general.php",
      "default": true
    },
    {
      "slug": "support",
      "view": "includes/admin/views/support.php"
    }
  ],
  "settings": [
    {
      "key": "bp_group_moderation_general_settings",
      "type": "array",
      "registered": "register_setting( 'bp_group_moderation_settings', ... ) in includes/admin/class-bp-group-moderation-settings.php",
      "save_path": "options.php; sanitize callback merges the toggles over the stored option",
      "read_via": "bp_group_moderation_fetch_settings( $key ) in includes/bp-group-moderation-general-functions.php",
      "subkeys": {
        "bp_group_moderation_auto_approve_admin": "bool, default true (activation)",
        "bp_group_moderation_send_emails": "bool, default true (activation)",
        "bp_group_moderation_delete_data_on_uninstall": "bool, default false; read by uninstall.php"
      }
    },
    {
      "key": "edd_sl_<md5 of slug + key + beta>",
      "type": "array",
      "written_by": "EDD_GROUP_MODERATION_PLUGIN_UPDATER::set_version_info_cache (3h version cache, autoload no)",
      "note": "not removed by uninstall.php (key-derived name)"
    }
  ],
  "transients": [],
  "group_meta": {
    "approval_status": "'pending' while a group waits; deleted on approve",
    "requested_status": "visibility the creator asked for, applied on approve"
  },
  "user_meta": [
    "bp_grp_moderation_rejected_group_{group_id}: group name, written when a decision email is sent"
  ],
  "notifications": {
    "component": "groups",
    "actions": [
      "new_group_pending",
      "group_approved",
      "group_rejected"
    ],
    "mark_read_nonce": "bp_group_moderation_notification_nonce (_wp_nonce GET)"
  },
  "cron": [
    {
      "hook": "bp_group_moderation_hourly_check",
      "schedule": "hourly",
      "scheduled_at": "bp_loaded",
      "cleared_at": "deactivation and uninstall"
    }
  ],
  "tables": [],
  "hooks_fired": [
    {
      "name": "bp_group_moderation_admin_setting_tabs",
      "type": "filter",
      "args": "array slug => label"
    },
    {
      "name": "bp_group_moderation_tab_contents",
      "type": "action",
      "where": "includes/admin/views/shell.php after the tab body"
    },
    {
      "name": "bp_group_moderation_group_pending_mail_subject",
      "type": "filter"
    },
    {
      "name": "bp_group_moderation_group_pending_mail",
      "type": "filter",
      "args": "message, group_id, admin_id"
    },
    {
      "name": "bp_group_moderation_group_decision_mail_subject",
      "type": "filter"
    },
    {
      "name": "bp_group_moderation_group_decision_mail",
      "type": "filter",
      "args": "message, group, decision"
    }
  ],
  "assets": {
    "css": "assets/css/bp-group-moderation-admin.css (+ .min, css-rtl twin built by grunt rtlcss)",
    "js": "assets/js/bp-group-moderation-admin.js (+ .min)",
    "enqueued_on": "bp-pending-groups, bp-group-moderation, toplevel_page_wbcomplugins"
  },
  "uninstall": "uninstall.php: clears the cron event; deletes the settings option and the legacy 1.0.0 licence options and transient only when bp_group_moderation_delete_data_on_uninstall is on",
  "ci": {
    "local": "bin/local-ci.sh",
    "build": "bin/build-release.sh",
    "gates": "~/.claude/skills/wp-plugin-development/scripts/gate-check.sh",
    "allowlists": "none",
    "licence_key_check": "bin/local-ci.sh step 4 warns when EDD_GROUP_MODERATION_FREE_LICENSE_KEY is empty; fails under BGM_RELEASE=1, which bin/build-release.sh sets"
  },
  "generated": {
    "at": "2026-11-18",
    "from": "manual scan of branch 1.0.1"
  },
  "legacy_data": {
    "options": [
      "edd_wbcom_group_moderation_license_key",
      "edd_wbcom_group_moderation_license_status"
    ],
    "transients": [
      "edd_wbcom_group_moderation_license_key_data"
    ],
    "written_by": "1.0.0 only; nothing writes them now",
    "cleaned_by": "edd_group_moderation_remove_legacy_licence_data() on admin_init while either option exists, and uninstall.php when delete-on-uninstall is on"
  }
}
